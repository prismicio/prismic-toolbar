{
	"ci": {
		"repoBranchBase": "master",
		"trackBranches": ["master"]
	},
	"defaultCompression": "none",
	"normalizeFilenames": "(^\\./dist/prismic-toolbar/[^/]+/).+$",
	"files": [
		{
			"path": "./dist/prismic-toolbar/*/prismic.js",
			"maxSize": "10KB"
		},
		{
			"path": "./dist/prismic-toolbar/*/v5.js",
			"maxSize": "13KB"
		},
		{
			"path": "./dist/prismic-toolbar/*/embedded-preview.js",
			"maxSize": "50KB"
		},
		{
			"path": "./dist/prismic-toolbar/*/toolbar.js",
			"maxSize": "10KB"
		},
		{
			"path": "./dist/prismic-toolbar/*/shell.html",
			"maxSize": "2KB"
		}
	]
}
