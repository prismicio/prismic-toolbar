{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["unicorn", "typescript", "oxc", "jsdoc", "react"],
	"env": {
		"browser": true,
		"node": true
	},
	"globals": {
		"CDN_HOST": "readonly",
		"__TOOLBAR_VERSION__": "readonly",
		"__TOOLBAR_LOCAL_EDITOR__": "readonly"
	},
	"rules": {
		"no-undef": "error",
		"no-useless-assignment": "error",
		"no-console": [
			"warn",
			{
				"allow": ["info", "warn", "error"]
			}
		],
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrorsIgnorePattern": "^_",
				"fix": {
					"imports": "safe-fix"
				}
			}
		],
		"typescript/consistent-type-imports": "error",
		"typescript/no-explicit-any": "error",
		"typescript/ban-ts-comment": "error",
		"jsdoc/check-tag-names": [
			"warn",
			{
				"definedTags": ["typeParam", "remarks", "defaultValue", "experimental"]
			}
		],
		"no-unused-expressions": [
			"error",
			{
				"allowTaggedTemplates": true
			}
		],
		"react/rules-of-hooks": "error",
		"react/exhaustive-deps": "warn"
	},
	"overrides": [
		{
			"files": ["**/*.ts", "**/*.tsx"],
			"rules": {
				"no-undef": "off",
				"prefer-const": "error"
			}
		},
		{
			"files": ["tests/infra/**"],
			"rules": {
				"react/rules-of-hooks": "off"
			}
		}
	],
	"ignorePatterns": ["playground/.next", "playground/next-env.d.ts"]
}
