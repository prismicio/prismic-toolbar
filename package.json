{
	"name": "prismic-toolbar",
	"version": "5.0.0",
	"description": "Prismic Toolbar: website previews for Prismic repositories",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "ssh://git@github.com/prismicio/prismic-toolbar.git"
	},
	"type": "module",
	"scripts": {
		"build": "npx tsx scripts/build.ts",
		"dev": "npx tsx scripts/dev.ts",
		"bundlewatch": "bundlewatch --config bundlewatch.config.json",
		"e2e": "playwright test",
		"e2e:ui": "npm run e2e -- --ui",
		"format": "oxfmt",
		"lint": "oxlint --deny-warnings",
		"types": "tsc --noEmit",
		"unit": "vitest run --coverage",
		"unit:watch": "vitest watch",
		"test": "npm run lint && npm run types && npm run unit && npm run build && npm run e2e"
	},
	"dependencies": {
		"preact": "11.0.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"bundlewatch": "1.1.0",
		"http-server": "14.1.1",
		"jsdom": "30.1.3",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": "26"
	}
}
