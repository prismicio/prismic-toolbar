{
	"name": "prismic-toolbar",
	"version": "5.0.0",
	"description": "Prismic Toolbar: website previews for Prismic repositories",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "ssh://git@github.com/prismicio/prismic-toolbar.git"
	},
	"type": "module",
	"scripts": {
		"build": "npx tsx scripts/build.ts",
		"dev": "npx tsx scripts/dev.ts",
		"bundlewatch": "bundlewatch --config bundlewatch.config.json",
		"e2e": "playwright test",
		"e2e:ui": "npm run e2e -- --ui",
		"format": "oxfmt",
		"lint": "oxlint --deny-warnings",
		"types": "tsc --noEmit",
		"unit": "vitest run --coverage",
		"unit:watch": "vitest watch",
		"test": "npm run lint && npm run types && npm run unit && npm run build && npm run e2e"
	},
	"dependencies": {
		"fast-equals": "6.0.0",
		"js-cookie": "3.0.8",
		"preact": "10.29.8",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/js-cookie": "3.0.6",
		"@types/node": "26.6.4",
		"@vitest/coverage-v8": "5.0.3",
		"bundlewatch": "0.4.2",
		"http-server": "14.1.1",
		"jsdom": "30.0.1",
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vitest": "5.0.3"
	},
	"engines": {
		"node": "26"
	}
}
